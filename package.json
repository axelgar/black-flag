    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "jose": "^6.2.12",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.142.0"
