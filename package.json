    "sea:deploy": "wrangler deploy -c server/wrangler.jsonc",
    "sea:bot": "tsx scripts/sea-bot.ts",
    "sea:bench": "tsx scripts/sea-bench.ts",
    "sea:load": "tsx scripts/sea-load.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
