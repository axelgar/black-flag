{
  "name": "black-flag",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "lines": "MEASURE=1 vitest run tests/lines.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "icons": "tsx scripts/icons.ts",
    "qr": "tsx scripts/qr.ts",
    "captain": "tsx scripts/captain.ts",
    "odds": "tsx scripts/odds.ts",
    "ships:pack": "tsx scripts/pack-models.ts",
    "props:pack": "tsx scripts/pack-models.ts --to props",
    "sea:dev": "tsx watch --env-file-if-exists=server/.dev.vars server/src/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "jose": "^6.2.16",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
